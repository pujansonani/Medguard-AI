# ==============================================================================
# MEDGUARD AI Environment Configuration
# ==============================================================================
# Execution Mode: "DEMO" (uses synthetic cohort) or "MIMIC" (uses local MIMIC-IV)
MEDGUARD_MODE=DEMO

# Raw MIMIC-IV paths (leave empty or set path if PhysioNet dataset is downloaded)
MIMIC_IV_DATA_DIR=data/raw/mimic-iv-2.2
MIMIC_IV_NOTE_DIR=data/raw/mimic-iv-note-2.2

# Preprocessed Data Directory
PROCESSED_DATA_DIR=data/processed
SYNTHETIC_DATA_DIR=data/synthetic

# Model Artifacts & Checkpoints
MODEL_CHECKPOINT_DIR=models/checkpoints
EXPERIMENT_ARTIFACTS_DIR=experiments/artifacts

# API & Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
BACKEND_API_URL=http://localhost:8000

# Device: "cpu", "cuda", or "mps"
DEVICE=cpu
RANDOM_SEED=42
